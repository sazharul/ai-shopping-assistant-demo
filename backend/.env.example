# StyleHub AI Shopping Assistant — Demo Configuration
DEMO_MODE=true
MAINTENANCE_MODE=false
ENVIRONMENT=development
DEBUG_MODE=true
CORS_ORIGINS=*

ADMIN_API_KEY=demo-admin-key
JWT_SECRET_KEY=change-me-use-long-random-string-in-production
JWT_ACCESS_TOKEN_MINUTES=60
JWT_REFRESH_TOKEN_DAYS=7
ADMIN_DEFAULT_EMAIL=admin@stylehub.demo
ADMIN_DEFAULT_PASSWORD=DemoAdmin123!
ADMIN_DEFAULT_NAME=Demo Admin

HANDOFF_BUSINESS_HOURS_ENFORCED=false
STRICT_SECURITY_ENFORCED=false
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# Required — get from https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o
EMBEDDING_MODEL=text-embedding-3-small

FAQ_DATA_PATH=data/demo_faq.json
PRODUCT_DATA_PATH=data/demo_products.json
FAISS_INDEX_PATH=data/faiss_index
PRODUCT_FAISS_INDEX_PATH=data/product_faiss_index
TOP_K_RESULTS=4
BM25_WEIGHT=0.4
SEMANTIC_WEIGHT=0.6
PRODUCT_MIN_RELEVANCE_SCORE=0.8

IMAGE_JSON_PATH=data/demo_product_images.json
IMAGE_BASE_URL=data/demo_images/
IMAGE_INDEX_PATH=data/product_image_index.faiss
IMAGE_IDS_PATH=data/product_image_index_ids.pkl
IMAGE_TOP_K_RESULTS=5
IMAGE_CLIP_MODEL=openai/clip-vit-base-patch32
IMAGE_MIN_SIMILARITY=0.75
IMAGE_LOCAL_DIR=data/demo_images
CHAT_STORE_PATH=data/stylehub_ai.db
CHAT_UPLOADS_PATH=data/chat_uploads

# Commerce API — stubbed when DEMO_MODE=true
ENOX_API_URL=http://localhost:8000
ENOX_API_KEY=demo-key

# Optional LangSmith tracing
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=StyleHubAI
